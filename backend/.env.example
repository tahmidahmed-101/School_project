# Local development needs none of this — `config.settings.local` supplies a
# throwaway SECRET_KEY and a SQLite database, so `manage.py runserver` works on
# a fresh clone with no .env at all. Copy this file when you want to override
# something, or to run production settings locally.
#
# REQUIRED in production (`config.settings.production` refuses to start
# without them, rather than falling back to something unsafe):
#   SECRET_KEY    — generate a fresh one, never reuse a value from a repo:
#                   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#   DATABASE_URL  — a real database. There is no SQLite fallback: a container
#                   filesystem is ephemeral, so it would be wiped every deploy.
DEBUG=False
SECRET_KEY=generate-your-own-do-not-use-this-value
DATABASE_URL=postgres://user:password@host:5432/dbname
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security & production settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# Gunicorn (see backend/entrypoint.sh)
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram staff bot (order alerts and commands). Create a bot with @BotFather
# for the token. Staff link their own Telegram account from the dashboard
# profile page. The webhook secret is any long random string; pass the same
# value as secret_token when registering the webhook with Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

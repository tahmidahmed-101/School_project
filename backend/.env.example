# Local development needs none of this — `config.settings.local` supplies a
# throwaway SECRET_KEY and a SQLite database, so `manage.py runserver` works on
# a fresh clone with no .env at all. Copy this file when you want to override
# something, or to run production settings locally.
#
# REQUIRED in production (`config.settings.production` refuses to start
# without them, rather than falling back to something unsafe):
#   SECRET_KEY    — generate a fresh one, never reuse a value from a repo:
#                   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#   DATABASE_URL  — a real database. There is no SQLite fallback: a container
#                   filesystem is ephemeral, so it would be wiped every deploy.
DEBUG=False
SECRET_KEY=generate-your-own-do-not-use-this-value
DATABASE_URL=postgres://user:password@host:5432/dbname
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security & production settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# Gunicorn (see backend/entrypoint.sh)
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60

# Email
# Outgoing email (docs/email.md). The console backend only prints mail to the
# log. For real delivery set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and the EMAIL_* values below, or save an SMTP server from the dashboard,
# which then takes precedence (its password needs SECRETS_ENCRYPTION_KEYS).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS (port 587) or implicit TLS (port 465): set at most one to True.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram staff bot (order alerts and commands). Create a bot with @BotFather
# for the token. Staff link their own Telegram account from the dashboard
# profile page. The webhook secret is any long random string; pass the same
# value as secret_token when registering the webhook with Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Encrypts credentials staff save from the dashboard (GA4 / Meta secrets).
# Comma-separated Fernet keys; the first encrypts. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEYS=

# Server-side Purchase conversions (docs/conversion-tracking.md). Each provider
# stays off until both of its values are set. Settings saved from the dashboard
# take precedence over these, per provider. Server-only: these are not the
# storefront's NEXT_PUBLIC_GA_ID / NEXT_PUBLIC_FB_PIXEL_ID, and must never be
# copied into the frontend.
# GA4: the same G-XXXXXXXXXX the storefront loads, plus a Measurement Protocol
# API secret from Admin > Data streams > (web stream) > Measurement Protocol.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Meta: the same pixel id the storefront loads, plus a Conversions API access
# token from Events Manager > (pixel) > Settings > Generate access token.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Optional: Events Manager > Test events code, while checking the setup.
META_TEST_EVENT_CODE=
# TikTok: the pixel id the storefront loads, plus an Events API access token from
# Events Manager > (pixel) > Settings > Generate access token.
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Newsletter campaigns (docs/email-campaigns.md). The public address of this
# API, for the unsubscribe link in every campaign email; required to send one.
PUBLIC_API_BASE_URL=
# Optional: a storefront unsubscribe page instead, with {token} in it.
NEWSLETTER_UNSUBSCRIBE_URL=
# Copies sent per `send_campaigns` run (the sweeper runs it every 15 minutes).
CAMPAIGN_BATCH_SIZE=200
# SMS campaigns (docs/sms-and-recovery.md): messages per run, one paid call each.
SMS_CAMPAIGN_BATCH_SIZE=100
# Abandoned-cart SMS: public storefront address for the link back to checkout,
# blank = nothing is sent. Hours a cart must sit idle, hours after which it is
# too old, and reminders per Dhaka day. The switch itself is in business settings.
STOREFRONT_BASE_URL=
CART_RECOVERY_IDLE_HOURS=2
CART_RECOVERY_MAX_AGE_HOURS=48
CART_RECOVERY_DAILY_CAP=50

# Public origin of the deployed site (no trailing slash). Inlined at build time; drives canonical URLs,
# the sitemap, robots.txt, Open Graph URLs and structured data.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Search Console domain/property verification (HTML tag method's content value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Meta Business Suite domain verification (the "content" value of the meta tag it gives you).
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to skip loading GA entirely.
NEXT_PUBLIC_GA_ID=

# Meta (Facebook/Instagram) Pixel ID. Leave unset to skip loading the pixel entirely.
NEXT_PUBLIC_FB_PIXEL_ID=

# TikTok Pixel ID. Leave unset to skip loading the pixel entirely.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

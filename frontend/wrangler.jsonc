{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kull-mart-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [
    { "pattern": "kullmart.com", "custom_domain": true },
    { "pattern": "www.kullmart.com", "custom_domain": true },
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kull-mart-web" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "kull-mart-web-cache" }],
  // Fill database_id from `npx wrangler d1 create kull-mart-web-tags`.
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "kull-mart-web-tags", "database_id": "TODO-d1-database-id" },
  ],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "images": { "binding": "IMAGES" },
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kull-mart-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kullmart.com", "custom_domain": true },
    { "pattern": "www.kullmart.com", "custom_domain": true },
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kull-mart-web" }],
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "3846319644a6464998530c423f312ebb" }],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "kull-mart-web-tags",
      "database_id": "3e1bd394-f453-44c4-8b09-93f59076ec0a",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "images": { "binding": "IMAGES" },
}

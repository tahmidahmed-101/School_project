{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kull-mart-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kullmart.com", "custom_domain": true },
    { "pattern": "www.kullmart.com", "custom_domain": true },
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "kull-mart-web" }],
  // Unused without a page cache; kept so the deployed DOQueueHandler class needs no delete migration.
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "images": { "binding": "IMAGES" },
}
